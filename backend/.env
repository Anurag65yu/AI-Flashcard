HF_API_KEY=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

# Optional overrides
# HF_MODEL=meta-llama/Llama-3.1-8B-Instruct
# PORT=5000
# FLASK_DEBUG=0

# Public-use limits (defaults shown)
# RATE_PER_MIN=5        # requests per visitor per minute
# RATE_PER_HOUR=30      # requests per visitor per hour
# DAILY_LIMIT=500       # requests per day for everyone together (0 = unlimited)
# MAX_CONCURRENT=4      # simultaneous model calls
# PROXY_HOPS=1          # set to 1 behind Render/Railway/Fly so visitor IPs are read correctly
# CORS_ORIGINS=         # leave empty (same-origin). Comma-separated origins only if the frontend is hosted elsewhere
# LOG_MODEL_OUTPUT=0    # 1 logs the start of unusable model output (contains user text), for debugging only
